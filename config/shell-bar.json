{
  "id": "omarchy.bar",
  "position": "top",
  "transparent": false,
  "centerAnchor": "omarchy.clock",
  "layout": {
    "left": [
      {
        "id": "omarchy.menu"
      },
      {
        "id": "omarchy.workspaces"
      },
      {
        "id": "omarchy.active-window",
        "maxWidth": 180
      }
    ],
    "center": [
      {
        "id": "omarchy.clock",
        "format": "ddd d MMM  HH:mm"
      }
    ],
    "right": [
      {
        "id": "omarchy.indicators"
      },
      {
        "id": "omarchy.system-update"
      },
      {
        "id": "omarchy.tray"
      },
      {
        "id": "omarchy.bluetooth"
      },
      {
        "id": "omarchy.network"
      },
      {
        "id": "omarchy.audio"
      },
      {
        "id": "omarchy.monitor"
      },
      {
        "id": "omarchy.power"
      }
    ]
  }
}
